# From sanity.io/manage -> your project. Same values as the site's SANITY_PROJECT_ID / SANITY_DATASET.
SANITY_STUDIO_PROJECT_ID=
TEAM_ENV=development
SANITY_STUDIO_ENVIRONMENT=development
SANITY_STUDIO_DATASET=development
# Production Studio builds require a separately authorized release configuration:
# TEAM_ENV=production, SANITY_STUDIO_ENVIRONMENT=production, SANITY_STUDIO_DATASET=production,
# SANITY_STUDIO_PRODUCTION_ACCESS=1. Never put API tokens in SANITY_STUDIO_*.
