# Where the contact form POSTs leads. Point this at the n8n webhook (or a
# Supabase edge function) once the lead system is built. Leave empty to
# disable submission on previews.
PUBLIC_LEAD_ENDPOINT=

# Booking link used by "Book a call" buttons (Cal.com / Calendly).
PUBLIC_BOOKING_URL=

# Sanity (sanity.io/manage -> your project). Blog posts and case studies are
# read from here at build time. The dataset is public, so no token is needed.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Traffic tools. Each is off until its value is set (see src/components/Tracking.astro).
# Google Analytics 4 measurement ID, e.g. G-ABC123XYZ
PUBLIC_GA_ID=
# Microsoft Clarity project ID (clarity.microsoft.com -> Settings -> Overview)
PUBLIC_CLARITY_ID=
# Google Search Console "HTML tag" verification: only the content="..." value
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools "HTML Meta Tag" verification: only the content="..." value
PUBLIC_BING_SITE_VERIFICATION=
