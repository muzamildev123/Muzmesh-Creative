---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import CallToAction from '@/components/CallToAction.astro';
import { pillars } from '@/data/site';
---

<BaseLayout
  title="Services"
  description="Design and brand, websites, social content and automation. Four services, one team, one monthly plan."
>
  <PageHeader
    title="Four services. One team."
    intro="We pick the platform that fits your business, not the one we happen to know."
  />
  <Section>
    <div class="grid gap-6 md:grid-cols-2">
      {
        pillars.map((p) => (
          <a href={`/services/${p.slug}`} class="rounded-2xl border border-line p-6 hover:border-brand">
            <h2 class="text-2xl font-bold">{p.name}</h2>
            <p class="mt-2 text-muted">{p.summary}</p>
            <ul class="mt-4 list-disc space-y-1 pl-5 text-sm">
              {p.includes.map((i) => <li>{i}</li>)}
            </ul>
          </a>
        ))
      }
    </div>
  </Section>
  <CallToAction />
</BaseLayout>
