---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import CallToAction from '@/components/CallToAction.astro';

const industries = (await getCollection('industries')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Industries" description="The industries MuzMesh Creative knows best, and what we build for each of them.">
  <PageHeader title="Industries we know" intro="We focus on a few industries so we can do better work for each one." />
  <Section>
    <div class="grid gap-6 md:grid-cols-2">
      {
        industries.map((ind) => (
          <a href={`/industries/${ind.id}`} class="rounded-2xl border border-line p-6 hover:border-brand">
            <h2 class="text-2xl font-bold">{ind.data.title}</h2>
            <p class="mt-2 text-muted">{ind.data.description}</p>
          </a>
        ))
      }
    </div>
  </Section>
  <CallToAction />
</BaseLayout>
