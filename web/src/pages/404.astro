---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
---

<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <h1 class="text-4xl font-bold">Page not found</h1>
    <p class="mt-4 text-muted">The page you are looking for has moved or does not exist.</p>
    <div class="mt-8 flex justify-center gap-3">
      <Button href="/">Go home</Button>
      <Button href="/blog" variant="secondary">Read the blog</Button>
    </div>
  </section>
</BaseLayout>
