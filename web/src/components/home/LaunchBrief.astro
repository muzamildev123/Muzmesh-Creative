---
// The final call to action: a fill-in-the-blanks launch brief.
// Sends to PUBLIC_LEAD_ENDPOINT (same as the contact form). Script: src/scripts/home/brief.js
import type { HomeContent } from '@/data/home';
import { briefTokens, rich } from '@/lib/home';
import { site } from '@/data/site';
import Arrow from './Arrow.astro';

interface Props {
  c: HomeContent;
  t: Record<string, string>;
}
const { c, t } = Astro.props;
const b = c.brief;
const promise = rich(b.promise, { ...t, ...briefTokens.promise });
const w = b.sentence, fm = b.form;
const fromEnv = import.meta.env.PUBLIC_BOOKING_URL;
const booking = b.bookingUrl || fromEnv || `mailto:${c.footer.email}?subject=${encodeURIComponent('Our launch call')}`;
const endpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT ?? '';
const firstName = c.faq.answeredBy.split(',')[0].trim() || site.name;
---

<section class="lc pad" id="launch-brief" aria-labelledby="lc-h">
<div class="lc-in">
  <span class="lab hint">{b.eyebrow}</span>
  <h2 class="lc-h" id="lc-h">{b.line1} <span>{b.line2}</span></h2>
  <form class="lc-box" id="lc-form" novalidate autocomplete="on" data-endpoint={endpoint} data-dev={import.meta.env.DEV ? '' : undefined} data-email={c.footer.email}>
    <p class="lc-s">{w.hi} <label class="lc-lab" for="lc-name">{fm.nameLabel}</label><input class="lc-f" id="lc-name" name="name" placeholder={fm.namePlaceholder} autocomplete="name" required maxlength="60" /> {w.from}{' '}<label class="lc-lab" for="lc-startup">{fm.startupLabel}</label><input class="lc-f" id="lc-startup" name="startup" placeholder={fm.startupPlaceholder} autocomplete="organization" required maxlength="60" />.{' '}
      {w.building} <label class="lc-lab" for="lc-what">{fm.whatLabel}</label><input class="lc-f" id="lc-what" name="building" placeholder={fm.whatPlaceholder} maxlength="90" />,{' '}
      {w.launch} <label class="lc-lab" for="lc-when">{fm.whenLabel}</label><select class="lc-f" id="lc-when" name="launch">{b.timings.map((x, i) => <option selected={i === 1}>{x}</option>)}</select>.{' '}
      {w.site} <label class="lc-lab" for="lc-site">{fm.siteLabel}</label><input class="lc-f" id="lc-site" name="site" placeholder={fm.sitePlaceholder} maxlength="90" inputmode="url" />.{' '}
      {w.reach} <label class="lc-lab" for="lc-email">{fm.emailLabel}</label><input class="lc-f" id="lc-email" name="email" type="email" placeholder={fm.emailPlaceholder} autocomplete="email" required maxlength="90" />.</p>
    <input class="lc-hp" name="company_url" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="lc-help" role="group" aria-label="What you need help with"><span>{b.needsLabel}</span>
      {b.needs.map((x) => <button type="button" class="lc-chip" aria-pressed="false">{x}</button>)}<button type="button" class="lc-chip" data-all aria-pressed="true">{b.allOfIt}</button>
    </div>
    <div class="lc-go">
      <p set:html={promise} />
      <button type="submit" class="pill white lc-send" id="lc-send" aria-disabled="true">{c.ctaLabel} <Arrow weight={1.7} /></button>
    </div>
    <p class="lc-need" id="lc-need" aria-live="polite"></p>
  </form>
  <div class="lc-done" id="lc-done" tabindex="-1" aria-live="polite">
    <ol class="lc-log" aria-label="What happens next">
      {b.next.map((n, i) => <li class={i === b.next.length - 1 ? 'y' : undefined}><b>{n.title}</b><span set:html={rich(n.text, { ...t, ...briefTokens.next })} /></li>)}
    </ol>
    <h3 class="lc-dh" set:html={rich(b.doneTitle, { ...t, ...briefTokens.done })} />
    <p class="lc-dp" set:html={rich(b.thanks, t)} />
    <div class="lc-who"><span class="fq-av" aria-hidden="true">{firstName.charAt(0)}</span><span><b>{c.faq.answeredBy}</b>{b.reader}</span>
      <a class="cta" href={booking} rel={/^https?:/.test(booking) ? 'noopener' : undefined} target={/^https?:/.test(booking) ? '_blank' : undefined}>{b.pickTime} <Arrow /></a></div>
    <button type="button" class="lc-edit" id="lc-edit">{b.changeAnswers}</button>
  </div>
</div>
</section>
