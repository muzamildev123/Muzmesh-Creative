---
interface Props {
  heading?: string;
  intro?: string;
  class?: string;
}

const { heading, intro, class: className } = Astro.props;
---

<section class:list={['mx-auto max-w-6xl px-4 py-16', className]}>
  {heading && <h2 class="text-3xl font-bold tracking-tight">{heading}</h2>}
  {intro && <p class="mt-3 max-w-2xl text-lg text-muted">{intro}</p>}
  <div class:list={[heading && 'mt-10']}>
    <slot />
  </div>
</section>
