---
// Homepage hero from the mockup (tools/hero-base/hero.html): full-screen black section,
// a big tight uppercase headline low on the left, and a row of three cards under it.
// Card images go in web/public/hero/ and are listed in `cards` below; a card without
// `src` shows a plain brand block (dark, yellow, dark).
interface Card {
  href: string;
  label: string;
  src?: string;
  alt?: string;
}

interface Props {
  lines?: string[];
  cards?: Card[];
}

const {
  lines = ['Easy to spot.', 'Hard to forget.'],
  cards = [
    { href: '/work', label: 'See our work' },
    { href: '/plans', label: 'See what is included' },
    { href: '/contact', label: 'Plan my launch' },
  ],
} = Astro.props;
---

<section class="hero">
  <div class="hero__inner">
    <h1 class="hero__headline">
      {
        lines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))
      }
    </h1>
    <ul class="hero__cards">
      {
        cards.map((card) => (
          <li class="hero__card">
            <a href={card.href}>
              <figure>{card.src && <img src={card.src} alt={card.alt ?? ''} loading="eager" />}</figure>
              <span class="sr-only">{card.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Measurements from the mockup, taken at a 2227 x 1417 px window. */
  .hero {
    --container: 71.85vw; /* 1600px at 2227px */
    --gutter: 16px;
    --pad-bottom: 76.5px;
    --h-size: 7.83cqw; /* of the content width: 125px at 1600 */
    --h-gap: 20px;
    --card-gap: 16px;
    --card-ratio: 1.4539;

    display: flex;
    min-height: 100svh;
    align-items: flex-end;
    padding: 0 var(--gutter) var(--pad-bottom);
    background: #000;
    color: var(--color-paper);
  }
  .hero__inner {
    container-type: inline-size;
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
  }
  .hero__headline {
    margin: 0 0 var(--h-gap) -0.032em; /* pull the first letter's side bearing back to the edge */
    font-family: var(--font-display);
    font-size: var(--h-size);
    font-weight: 900;
    font-stretch: 86%;
    line-height: 0.858;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .hero__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--card-gap);
  }
  .hero__card a {
    position: relative;
    display: block;
    border-radius: 4px;
  }
  .hero__card a:focus-visible {
    outline: 2px solid var(--color-marker);
    outline-offset: 3px;
  }
  .hero__card figure {
    margin: 0;
    overflow: hidden;
    aspect-ratio: var(--card-ratio);
    border-radius: 4px;
    background: linear-gradient(135deg, #26262c, #121215);
  }
  .hero__card:nth-child(2) figure {
    background: linear-gradient(135deg, #ffe45c, var(--color-marker));
  }
  .hero__card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-snap);
  }
  .hero__card a:hover img {
    transform: scale(1.03);
  }

  @media (max-width: 767px) {
    .hero {
      --container: 100%;
      --pad-bottom: 24px;
    }
    .hero__headline {
      font-size: 13cqw;
    }
    /* Phones: a swipe row of cards */
    .hero__cards {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 82%;
      margin-right: calc(var(--gutter) * -1);
      padding-right: var(--gutter);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .hero__card {
      scroll-snap-align: start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__card img {
      transition: none;
    }
  }
</style>
