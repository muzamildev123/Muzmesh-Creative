# Copy to .dev.vars for local development. Never commit .dev.vars.
# Shows the sign-in link on screen instead of emailing it. Only honoured on localhost.
DEV_SHOW_LOGIN_LINK=1
# The first person to sign in with this address becomes MuzMesh staff, only while the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=you@example.com
# Production only: Resend key and sender for sign-in emails.
# RESEND_API_KEY=
# EMAIL_FROM=Launch Room <login@yourdomain.com>

# ---------- Automatic posting ----------
# The app's public address. Short links and alert emails use it.
APP_ORIGIN=http://localhost:4321
# Encrypts LinkedIn and X sign-ins. Make one with: openssl rand -base64 32
# TOKEN_KEY=
# LinkedIn developer app (products: "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect").
# Redirect URL: <APP_ORIGIN>/connect/linkedin/callback
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# Set to 1 once LinkedIn approves the Community Management API, to post as company pages.
# LINKEDIN_ORG_POSTING=
# X developer app (OAuth 2.0, type "Web App", read and write). Callback: <APP_ORIGIN>/connect/x/callback
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# ---------- Website stats ----------
# A Google Cloud service account key (the whole JSON on one line) with the Analytics Data API
# and the Search Console API turned on. Add its email to each client's GA4 and Search Console.
# GOOGLE_SERVICE_ACCOUNT=
