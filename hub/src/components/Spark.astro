---
// A one-series line of daily numbers. Each day has a hover target with its value, and the same
// numbers are in a table for screen readers and anyone who prefers one.
interface Props { points: { day: string; value: number }[]; label: string }
const { points, label } = Astro.props;
const W = 280, H = 56, PAD = 3;
const max = Math.max(1, ...points.map((p) => p.value));
const step = points.length > 1 ? (W - PAD * 2) / (points.length - 1) : 0;
const xy = points.map((p, i) => [PAD + i * step, H - PAD - (p.value / max) * (H - PAD * 2)] as const);
const line = xy.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');
const area = xy.length ? `${line} L${xy[xy.length - 1]![0].toFixed(1)} ${H} L${xy[0]![0].toFixed(1)} ${H} Z` : '';
const fmt = (d: string) => new Date(`${d}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
---
{points.length > 1 && (
  <figure class="lr-spark">
    <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label={`${label}, ${fmt(points[0]!.day)} to ${fmt(points[points.length - 1]!.day)}. Highest day ${max}.`}>
      <path class="lr-spark-area" d={area} />
      <path class="lr-spark-line" d={line} vector-effect="non-scaling-stroke" />
      {xy.map(([x], i) => <rect class="lr-spark-hit" x={x - step / 2} y="0" width={Math.max(step, 4)} height={H}><title>{fmt(points[i]!.day)}: {points[i]!.value}</title></rect>)}
    </svg>
    <details class="lr-small"><summary>Show as a table</summary>
      <table class="lr-table"><thead><tr><th scope="col">Day</th><th scope="col" class="is-num">{label}</th></tr></thead>
        <tbody>{points.map((p) => <tr><td>{fmt(p.day)}</td><td class="is-num">{p.value}</td></tr>)}</tbody></table>
    </details>
  </figure>
)}
