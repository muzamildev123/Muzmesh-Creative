---
import Base from '../layouts/Base.astro';
Astro.response.status = 404;
---
<Base title="Not found">
  <div slot="narrow" class="lr-stack">
    <span class="mm-label">Not found</span>
    <h1 class="mm-h3">That page does not exist, or your account cannot open it.</h1>
    <p><a class="mm-btn is-solid is-md" href="/">Back to Launch Room</a></p>
  </div>
</Base>
