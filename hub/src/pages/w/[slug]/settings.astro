---
import WorkspaceFields from '../../../components/WorkspaceFields.astro';
import Workspace from '../../../layouts/Workspace.astro';
import * as admin from '../../../lib/admin';
import { readBrand } from '../../../lib/brand';
import * as repo from '../../../lib/repo';
import { ROLE_LABEL } from '../../../lib/types';
import { db, done, formOf, loadWorkspace, notFound } from '../../../lib/web';

const access = await loadWorkspace(Astro);
if (access instanceof Response) return access;
const { ws, base, user } = access;
if (!user.is_staff) return notFound();
const here = `${base}/settings`;

if (Astro.request.method === 'POST') {
  const f = await formOf(Astro);
  switch (f.action) {
    case 'workspace': return done(Astro, here, await admin.updateWorkspace(db(), user, ws, f), 'Settings saved.');
    case 'brand': return done(Astro, `${here}#brand`, await admin.saveBrand(db(), user, ws, f.brand_config), 'Brand kit saved.');
    case 'member_add': return done(Astro, `${here}#people`, await admin.addMember(db(), user, ws, f), 'Saved. They can sign in with that email now.');
    case 'member_remove': return done(Astro, `${here}#people`, await admin.removeMember(db(), user, ws, f.user), 'Removed. Their connected AI apps were cut off too.');
    default: return notFound();
  }
}
const members = await repo.listMembers(db(), ws.id);
const brand = readBrand(ws.brand_config);
---
<Workspace access={access} title="Settings" tab="settings">
  <div class="lr-head"><h2>Settings</h2><span class="lr-small lr-faint">Only MuzMesh sees this page.</span></div>
  <div class="lr-two">
    <div class="lr-stack is-lg">
      <section class="lr-card lr-stack" aria-labelledby="ws-h">
        <span class="mm-label" id="ws-h">Workspace</span>
        <form method="post" class="lr-stack">
          <WorkspaceFields ws={ws} />
          <div><button class="mm-btn is-primary is-md" type="submit" name="action" value="workspace">Save</button></div>
        </form>
      </section>
      <section class="lr-card lr-stack" id="brand" aria-labelledby="bk-h">
        <span class="mm-label" id="bk-h">Brand kit</span>
        <p class="lr-muted">{brand ? `Loaded: ${brand.name}.` : 'Not added yet.'} Paste the client's <code class="lr-code">brand.config.json</code> from the brand kit tool. It drives the brand page, image templates, the brand check and the context pack.</p>
        <form method="post" class="lr-stack">
          <div class="lr-field"><label for="brand_config">brand.config.json</label><textarea class="lr-textarea lr-code" id="brand_config" name="brand_config" rows="12" spellcheck="false">{brand ? ws.brand_config : ''}</textarea></div>
          <div><button class="mm-btn is-primary is-md" type="submit" name="action" value="brand">Save brand kit</button></div>
        </form>
      </section>
    </div>
    <section class="lr-card lr-stack" id="people" aria-labelledby="pp-h">
      <span class="mm-label" id="pp-h">People</span>
      {members.length === 0 ? <p class="lr-muted">No one from the client has access yet.</p> : (
        <ul class="lr-list">
          {members.map((m) => (
            <li class="lr-row">
              <span>{m.name || m.email}<br /><span class="lr-small lr-faint">{m.name ? `${m.email} · ` : ''}{ROLE_LABEL[m.role]}</span></span>
              <form method="post" class="lr-inline"><input type="hidden" name="user" value={m.user_id} /><button class="lr-linkbtn" type="submit" name="action" value="member_remove" data-confirm={`Remove ${m.email} from ${ws.name}?`}>Remove</button></form>
            </li>
          ))}
        </ul>
      )}
      <form method="post" class="lr-stack">
        <div class="lr-field"><label for="email">Email</label><input class="lr-input" id="email" name="email" type="email" required maxlength="200" /></div>
        <div class="lr-formrow">
          <div class="lr-field"><label for="mname">Name (optional)</label><input class="lr-input" id="mname" name="name" maxlength="80" /></div>
          <div class="lr-field">
            <label for="role">Role</label>
            <select class="lr-select" id="role" name="role" aria-describedby="role-hint">
              <option value="owner">Owner</option><option value="editor">Editor</option><option value="viewer">Viewer</option>
            </select>
          </div>
        </div>
        <p class="lr-hint" id="role-hint">Owners approve posts and edit the context pack. Editors write posts and send requests. Viewers only read. Adding someone again changes their role.</p>
        <div><button class="mm-btn is-solid is-md" type="submit" name="action" value="member_add">Add or update</button></div>
      </form>
      <p class="lr-small lr-faint">No invitation email is sent. Tell them to sign in at this address with their email.</p>
    </section>
  </div>
</Workspace>
