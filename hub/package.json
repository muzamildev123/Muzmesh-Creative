{
  "name": "launch-room",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "wrangler dev",
    "check": "astro check",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply launch-room --local",
    "db:remote": "wrangler d1 migrations apply launch-room --remote",
    "seed:local": "wrangler d1 execute launch-room --local --file=./seed/dev-seed.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.7",
    "astro": "^7.4.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.1.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
