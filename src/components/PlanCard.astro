---
import Button from './Button.astro';
import { site } from '@/data/site';

interface Props {
  name: string;
  price: number;
  blurb: string;
  features: string[];
  recommended: boolean;
}

const { name, price, blurb, features, recommended } = Astro.props;
---

<article
  class:list={[
    'flex flex-col rounded-2xl border p-6',
    recommended ? 'border-brand shadow-lg ring-1 ring-brand' : 'border-line',
  ]}
>
  {recommended && <p class="mb-2 text-xs font-semibold tracking-wide text-brand uppercase">Recommended for most</p>}
  <h3 class="text-xl font-bold">{name}</h3>
  <p class="mt-2">
    <span class="text-sm text-muted">From</span>{" "}
    <span class="text-3xl font-bold">${price.toLocaleString('en-US')}</span>{" "}
    <span class="text-sm text-muted">/mo</span>
  </p>
  <p class="mt-3 text-muted">{blurb}</p>
  <ul class="mt-6 flex-1 space-y-2 text-sm">
    {features.map((f) => <li class="flex gap-2"><span aria-hidden="true" class="text-brand">✓</span>{f}</li>)}
  </ul>
  <div class="mt-8">
    <Button href={site.bookingUrl} variant={recommended ? 'primary' : 'secondary'}>Book a call</Button>
  </div>
</article>
